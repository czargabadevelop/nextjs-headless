# -----------------------------------------------------------------------------
# Headless WordPress connection
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# -----------------------------------------------------------------------------

# Base URL of your WordPress site (no trailing slash, no /wp-json suffix)
WORDPRESS_URL=http://localhost:8080

# Optional: only needed if your WP REST API root differs from WORDPRESS_URL
# WP_JSON_URL=http://localhost:8080/wp-json

# Optional: comma-separated hosts that serve media when they are NOT on the
# WordPress origin (S3, CDN, ...). Protocol defaults to https.
# WP_IMAGE_HOSTS=cdn.example.com, media.example.com

# Public origin of this Next.js app (used for canonical URLs / sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables POST /api/revalidate (on-demand cache purge on publish)
# WP_WEBHOOK_SECRET=change-me
